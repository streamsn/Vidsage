# Copy this to apps/web/.env.local (web app) and fill in real values.
# The extension only needs the two NEXT_PUBLIC_* values below, copied into
# apps/extension/.env during M2 setup.

# --- Supabase (Settings -> API in the Supabase dashboard) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth (Google Cloud Console -> APIs & Services -> Credentials) ---
# Web application type. Authorized redirect URI must be
# https://<extension-id>.chromiumapp.org/ once the extension ID is known.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- YouTube Data API (same Google Cloud project, enable "YouTube Data API v3") ---
# Used for video metadata (title/channel/duration) and related-video search.
YOUTUBE_DATA_API_KEY=

# --- Supadata (https://supadata.ai) ---
# Transcript text source — YouTube blocks direct server-side scraping of its
# caption endpoints, so this handles that. Free tier: 100 transcripts/month.
SUPADATA_API_KEY=

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Stripe (Developers -> API keys / Webhooks in the Stripe dashboard) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_SMALL=
STRIPE_PRICE_ID_LARGE=

# --- App URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
