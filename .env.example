# Copy this to apps/web/.env.local and fill in real values.

# --- Supabase (Settings -> API in the Supabase dashboard) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth (Google Cloud Console -> APIs & Services -> Credentials) ---
# Web application type. Add your dev/prod origin(s) under "Authorized
# JavaScript origins" on that OAuth client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Same client ID, exposed client-side for the pricing/playground pages'
# Google sign-in button (Sign In With Google JS SDK).
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=

# --- YouTube Data API (same Google Cloud project, enable "YouTube Data API v3") ---
# Used for video metadata (title/channel/duration) and related-video search.
YOUTUBE_DATA_API_KEY=

# --- Supadata (https://supadata.ai) ---
# Transcript text source — YouTube blocks direct server-side scraping of its
# caption endpoints, so this handles that. Free tier: 100 transcripts/month.
SUPADATA_API_KEY=

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Stripe (Developers -> API keys / Webhooks in the Stripe dashboard) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_SMALL=
STRIPE_PRICE_ID_LARGE=

# --- App URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
